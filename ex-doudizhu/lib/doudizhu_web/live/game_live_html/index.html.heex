<Layouts.app
  flash={@flash}
  connected={@connected}
  locale={@locale}
  language_tag={@language_tag}
>
  <section :if={@mode == :welcome} id="welcome-panel" class="panel welcome-panel">
    <div>
      <p class="eyebrow">{gettext("Three-player climbing game")}</p>
      <h1>{gettext("Call the landlord.")}<br />{gettext("Outplay your friends.")}</h1>
      <p class="lede">
        {gettext(
          "Create a private table or follow an invitation link. Your hand stays private and every move is validated by the server."
        )}
      </p>
    </div>

    <form id="welcome-form" class="join-card" phx-submit="enter-room">
      <label for="player-name">{gettext("Your name")}</label>
      <input
        id="player-name"
        name="name"
        value={@player_name}
        maxlength="30"
        autocomplete="nickname"
        required
        placeholder={gettext("e.g. Alice")}
      />
      <p :if={@room_id} id="invitation-note" class="muted">
        {gettext("You have been invited to a private table.")}
      </p>
      <div class="button-row">
        <button
          :if={!@room_id}
          class="button primary"
          type="submit"
          phx-disable-with={gettext("Creating…")}
        >
          {gettext("Create private table")}
        </button>
        <button
          :if={@room_id}
          class="button primary"
          type="submit"
          phx-disable-with={gettext("Joining…")}
        >
          {gettext("Join table")}
        </button>
        <button class="button secondary" type="button" phx-click="open-replay-library">
          {gettext("Replay a game")}
        </button>
      </div>
      <p id="welcome-error" class="error" role="alert">{@welcome_error}</p>
    </form>
  </section>

  <section :if={@mode == :room} id="room-panel" class="panel room-panel">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{gettext("Private table")}</p>
        <h2>{gettext("Waiting room")}</h2>
      </div>
      <span id="room-status" class="pill">{room_status_name(@room["status"])}</span>
    </div>

    <div :if={@invite_code} id="invitation-card" class="invitation-card">
      <div>
        <span class="muted">{gettext("Invitation code")}</span>
        <strong id="invite-code" class="invite-code">{@invite_code}</strong>
      </div>
      <button
        id="copy-invite-button"
        class="button secondary"
        type="button"
        phx-hook="Clipboard"
        data-copy={~p"/?room=#{@room_id}&invite=#{@invite_code}"}
        data-copy-kind="invite"
      >
        {gettext("Copy invite link")}
      </button>
    </div>

    <ol id="seat-list" class="seat-list" aria-label={gettext("Players")}>
      <%= for position <- 1..3 do %>
        <% seat = Enum.find(@room["seats"], &(&1["position"] == position)) %>
        <li class="seat">
          <span class="seat-number">{position}</span>
          <div class="seat-details">
            <strong>{if seat, do: seat["player_name"], else: gettext("Open seat")}</strong>
            <span>
              <%= cond do %>
                <% seat && seat["player_id"] == @identity_id -> %>
                  {gettext("You")}
                <% seat -> %>
                  {gettext("Connected player")}
                <% true -> %>
                  {gettext("Waiting for a friend")}
              <% end %>
            </span>
          </div>
          <span :if={seat} class="ready-mark">
            {if seat["ready"],
              do: gettext("Ready"),
              else: pgettext("readiness status", "Not ready")}
          </span>
        </li>
      <% end %>
    </ol>

    <% own_seat = own_seat(@room, @identity_id) %>
    <% owner? = @room["owner_id"] == @identity_id %>
    <% can_start? = can_start?(@room, @identity_id) %>
    <div class="room-actions">
      <button id="ready-button" class="button primary" type="button" phx-click="ready">
        {if own_seat && own_seat["ready"],
          do: pgettext("readiness action", "Not ready"),
          else: gettext("I’m ready")}
      </button>
      <button
        :if={owner?}
        id="start-button"
        class="button accent"
        type="button"
        phx-click="start-game"
        disabled={!can_start?}
        phx-disable-with={gettext("Starting…")}
      >
        {gettext("Start game")}
      </button>
    </div>
    <p id="room-message" class={if @room_error, do: "error", else: "muted"} role="status">
      {@room_error ||
        if(can_start?,
          do: gettext("Everyone is ready."),
          else: gettext("The game starts when all three players are ready.")
        )}
    </p>
  </section>

  <section
    :if={@mode == :replay_library}
    id="replay-library-panel"
    class="panel replay-library-panel"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">{gettext("Your history")}</p>
        <h2>{gettext("Recorded games")}</h2>
      </div>
      <button class="button ghost" type="button" phx-click="close-replay-library">
        {gettext("Back")}
      </button>
    </div>
    <p class="muted replay-intro">
      {gettext(
        "Completed replays are rebuilt from the original deal and accepted commands. Enter any public game ID to review all hands, or choose one of your recent games."
      )}
    </p>
    <form id="replay-id-form" class="replay-id-form" phx-submit="open-replay">
      <label for="replay-game-id">{gettext("Public game ID")}</label>
      <div class="button-row">
        <input
          id="replay-game-id"
          name="game_id"
          autocomplete="off"
          required
          placeholder="game_…"
        />
        <button class="button accent" type="submit" phx-disable-with={gettext("Opening…")}>
          {gettext("Open replay")}
        </button>
      </div>
    </form>

    <div id="replay-list" class="replay-list">
      <div :if={Enum.empty?(@replay_games)} class="replay-empty">
        {gettext("No recorded games were found for this guest identity.")}
      </div>
      <article :for={game <- @replay_games} class="replay-entry">
        <div>
          <h3>{Enum.map_join(game["players"], " · ", & &1["name"])}</h3>
          <p>
            {replay_date(game["played_at"])} · {turn_count(game["final_version"])} ·
            <span class="replay-result">{replay_result(game)}</span>
          </p>
          <p>{gettext("Game ID: %{game_id}", game_id: game["public_replay_id"])}</p>
        </div>
        <button
          class="button accent"
          type="button"
          phx-click="open-replay"
          phx-value-game-id={game["game_id"]}
        >
          {gettext("Watch replay")}
        </button>
      </article>
    </div>
    <p id="replay-library-error" class="error" role="alert">{@replay_error}</p>
  </section>

  <%= if @mode in [:game, :replay] do %>
    <% snapshot = @snapshot %>
    <% game = snapshot["game"] %>
    <% players = snapshot["players"] %>
    <% you = snapshot["you"] %>
    <% replaying? = @mode == :replay %>
    <section
      id="game-panel"
      class="game-layout"
      phx-hook="GameAudio"
      data-audio-manifest="/audio/gameplay/manifest.json"
      data-audio-player-ids={Jason.encode!(Enum.map(players, & &1["player_id"]))}
    >
      <section class="panel table-panel">
        <div class="game-header">
          <div>
            <p class="eyebrow">{gettext("Game in progress")}</p>
            <h2 id="phase-title">
              {if replaying?, do: gettext("Replay · "), else: ""}{phase_name(game["phase"])}
            </h2>
          </div>
          <div class="game-meta">
            <span :if={you && you["role"]} id="role-pill" class="pill">
              {role_name(you["role"])}
            </span>
            <span id="version-label" class="muted">
              {gettext("Turn %{turn}", turn: snapshot["sequence"])}
            </span>
            <button
              :if={!replaying?}
              id="resync-button"
              class="button ghost compact"
              type="button"
              phx-click="resync"
            >
              {gettext("Resync")}
            </button>
          </div>
        </div>

        <div :if={replaying?} id="replay-controls" class="replay-controls">
          <% frame_count = @replay.metadata["frame_count"] %>
          <% frame_index = @replay_frame["index"] %>
          <button class="button ghost compact" type="button" phx-click="exit-replay">
            {gettext("Exit replay")}
          </button>
          <button
            id="copy-replay-link-button"
            class="button ghost compact"
            type="button"
            phx-hook="Clipboard"
            data-copy={~p"/?replay=#{@replay.metadata["public_replay_id"]}"}
            data-copy-kind="replay"
          >
            {gettext("Copy link")}
          </button>
          <button
            class="button ghost compact"
            type="button"
            aria-label={gettext("Previous replay frame")}
            phx-click="previous-replay-frame"
            disabled={frame_index == 0}
          >
            ←
          </button>
          <button class="button accent compact" type="button" phx-click="toggle-replay">
            {if @replay_playing,
              do: gettext("Pause"),
              else: pgettext("replay control", "Play")}
          </button>
          <button
            class="button ghost compact"
            type="button"
            aria-label={gettext("Next replay frame")}
            phx-click="next-replay-frame"
            disabled={frame_index >= frame_count - 1}
          >
            →
          </button>
          <form id="replay-seek-form" phx-change="seek-replay">
            <input
              id="replay-slider"
              name="index"
              type="range"
              min="0"
              max={max(0, frame_count - 1)}
              value={frame_index}
              aria-label={gettext("Replay position")}
              phx-debounce="100"
            />
          </form>
          <strong id="replay-position">{replay_step(frame_index, frame_count)}</strong>
        </div>

        <div :if={!replaying?} id="opponents" class="opponents">
          <%= for player <- opponent_players(players, you && you["player_id"]) do %>
            <div class={[
              "player-summary",
              player["player_id"] == current_player_id(game) && "current"
            ]}>
              <span class="avatar">{player["name"] |> String.first() |> String.upcase()}</span>
              <div>
                <strong>{player["name"]}</strong>
                <span>{card_count(get_in(game, ["hand_counts", player["player_id"]]) || 0)}</span>
                <span :if={player["player_id"] == game["landlord"]} class="landlord-mark">
                  {gettext("Landlord")}
                </span>
              </div>
            </div>
          <% end %>
        </div>

        <section
          :if={replaying?}
          id="replay-hands"
          class="replay-hands"
          aria-label={gettext("All player hands")}
        >
          <%= for player <- players do %>
            <% cards = snapshot["hands"][player["player_id"]] || [] %>
            <% role = snapshot["roles"][player["player_id"]] %>
            <div class="replay-hand">
              <div class="replay-hand-heading">
                <strong>{player["name"]}</strong>
                <span>{role_name(role)} · {card_count(length(cards))}</span>
              </div>
              <div class="mini-cards replay-hand-cards">
                <span :if={Enum.empty?(cards)} class="empty-state">{gettext("No cards")}</span>
                <.mini_card :for={card <- cards} card_id={card} />
              </div>
            </div>
          <% end %>
        </section>

        <div class="table-center">
          <div id="turn-indicator" class="turn-indicator">
            {turn_message(game, players, @identity_id, replaying?)}
          </div>
          <div id="lead-area" class="lead-area">
            <span class="muted">{gettext("Current lead")}</span>
            <div id="lead-cards" class="mini-cards">
              <%= if game["current_lead"] do %>
                <.mini_card
                  :for={card <- game["current_lead"]["combination"]["cards"] || []}
                  card_id={card}
                />
              <% else %>
                <span class="empty-state">{gettext("No cards led")}</span>
              <% end %>
            </div>
            <strong id="lead-description">
              {combination_name(game["current_lead"] && game["current_lead"]["combination"])}
            </strong>
          </div>
          <div :if={replaying?} id="bottom-area" class="bottom-area">
            <span class="muted">{gettext("Bottom cards")}</span>
            <div id="bottom-cards" class="mini-cards">
              <span :if={Enum.empty?(snapshot["bottom_cards"])} class="empty-state">
                {gettext("Not dealt")}
              </span>
              <.mini_card :for={card <- snapshot["bottom_cards"]} card_id={card} />
            </div>
          </div>
        </div>

        <%= if !replaying? do %>
          <% cards = (you && you["hand"]) || [] %>
          <div id="hand-heading" class="hand-heading">
            <div>
              <span class="muted">{gettext("Your hand")}</span>
              <strong id="hand-count">{card_count(length(cards))}</strong>
            </div>
            <span id="selection-count" class="muted">
              {selected_count(MapSet.size(@selected))}
            </span>
          </div>
          <div id="hand" class="hand" aria-label={gettext("Your cards")}>
            <.card
              :for={card <- cards}
              card_id={card}
              selected={MapSet.member?(@selected, card)}
            />
          </div>

          <% bidding_turn? = game["phase"] == "bidding" && game["current_bidder"] == @identity_id %>
          <% playing_turn? = game["phase"] == "playing" && game["current_player"] == @identity_id %>
          <% pending? = !is_nil(@pending_version) %>
          <div id="action-bar" class="action-bar">
            <div :if={bidding_turn?} id="bid-controls" class="button-row">
              <button
                :for={bid <- 1..3}
                class="button bid-button"
                type="button"
                phx-click="place-bid"
                phx-value-bid={bid}
                disabled={pending?}
              >
                {bid_label(bid)}
              </button>
              <button
                class="button ghost"
                type="button"
                phx-click="auction-pass"
                disabled={pending?}
              >
                {pgettext("bidding action", "Pass")}
              </button>
            </div>
            <div :if={playing_turn?} id="play-controls" class="button-row">
              <button
                class="button accent"
                type="button"
                phx-click="play-selected"
                disabled={pending? || MapSet.size(@selected) == 0}
              >
                {gettext("Play selected")}
              </button>
              <button
                class="button ghost"
                type="button"
                phx-click="play-pass"
                disabled={pending? || is_nil(game["current_lead"])}
              >
                {pgettext("playing action", "Pass")}
              </button>
              <button
                class="button ghost"
                type="button"
                phx-click="clear-selection"
                disabled={pending? || MapSet.size(@selected) == 0}
              >
                {gettext("Clear")}
              </button>
            </div>
            <p :if={!bidding_turn? && !playing_turn? && game["phase"] != "finished"} class="muted">
              {gettext("Waiting for another player…")}
            </p>
          </div>
        <% end %>

        <section :if={game["phase"] == "finished" && game["settlement"]} class="settlement">
          <% settlement = game["settlement"] %>
          <% winner = Enum.find(players, &(&1["player_id"] == settlement["winning_player"])) %>
          <p class="eyebrow">{gettext("Game finished")}</p>
          <h3 id="winner-title">
            {winner_title(
              if(winner, do: winner["name"], else: gettext("A player")),
              settlement["winning_side"]
            )}
          </h3>
          <div id="score-list" class="score-list">
            <div :for={player <- players} class="score-row">
              <% delta = settlement["deltas"][player["player_id"]] || 0 %>
              <span>{player["name"]}</span>
              <strong class={if delta >= 0, do: "score-positive", else: "score-negative"}>
                {score(delta)}
              </strong>
            </div>
          </div>
        </section>

        <p id="game-error" class="error centered" role="alert">{@game_error}</p>
      </section>

      <aside class="panel activity-panel">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{gettext("Table activity")}</p>
            <h2>{gettext("Game log")}</h2>
          </div>
        </div>
        <ol
          id="event-log"
          class="event-log"
          phx-update="stream"
          phx-hook="ScrollToBottom"
          aria-live="polite"
        >
          <li :for={{dom_id, entry} <- @streams.events} id={dom_id}>
            {event_description(entry.event, players)}
          </li>
        </ol>
      </aside>
    </section>
  <% end %>

  <div :if={@toast} id="toast" class="toast" role="status">{@toast}</div>
</Layouts.app>
